// Chạy từ thư mục gốc FreshRescue.
var settingsPath = Path.Combine(
    Directory.GetCurrentDirectory(),
    "src",
    "FreshRescue.API",
    "appsettings.Development.json");

if (!File.Exists(settingsPath))
{
    throw new FileNotFoundException(
        "Không tìm thấy cấu hình Development của API.",
        settingsPath);
}

var configuration = new ConfigurationBuilder()
    .AddJsonFile(settingsPath, optional: false)
    .AddEnvironmentVariables()
    .Build();

var connectionString =
    configuration.GetConnectionString("Default")
    ?? throw new InvalidOperationException(
        "Thiếu ConnectionStrings:Default.");

var services = new ServiceCollection();

services.AddLogging();

// Dùng chính DataAccess của FreshRescue.
services.AddDataAccessLayer(connectionString);

// Cấu hình Identity cho công cụ Seeder độc lập.
services.AddIdentityCore<AppUser>(options =>
{
    options.User.RequireUniqueEmail = true;
})
.AddRoles<AppRole>()
.AddEntityFrameworkStores<FreshRescueDbContext>();

using var provider = services.BuildServiceProvider(
    validateScopes: true);

using var scope = provider.CreateScope();

var roleManager = scope.ServiceProvider
    .GetRequiredService<RoleManager<AppRole>>();

var userManager = scope.ServiceProvider
    .GetRequiredService<UserManager<AppUser>>();

await DbSeeder.SeedIdentityAsync(
    roleManager,
    userManager,
    configuration["Seed:AdminEmail"] ?? "",
    configuration["Seed:AdminPassword"] ?? "");

Console.WriteLine("Seed Role và SystemAdmin hoàn thành.");