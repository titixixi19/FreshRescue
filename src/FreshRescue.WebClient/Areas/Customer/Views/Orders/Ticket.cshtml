@model OrderTicketViewModel
@{
    var order = Model.Order;
    var ticket = Model.Ticket;
    ViewData["Title"] = $"Vé {ticket.OrderCode}";
}

<div class="fr-narrow">
    <a asp-action="Details" asp-route-id="@order.Id" class="small d-print-none">‹ Chi tiết đơn</a>

    <div class="card fr-ticket shadow-sm mt-2">
        <div class="card-body p-4 text-center">
            <div class="small text-muted">Vé nhận hàng</div>
            <h1 class="h5 mb-3">@ticket.StoreName</h1>

            @* Vẽ nguyên chuỗi token — không cắt, không định dạng lại (03-API-CONTRACT.md §4.3). *@
            <div class="fr-qr fr-qr-lg mx-auto" data-qr-token="@ticket.Token" role="img" aria-label="Mã QR của đơn @ticket.OrderCode"></div>

            <div class="small text-muted mt-3">Mã đơn — đọc cho nhân viên nếu không quét được</div>
            <div class="fr-order-code fr-order-code-lg">@ticket.OrderCode</div>

            <hr />
            <dl class="row small text-start mb-0">
                <dt class="col-5">Nhận hàng</dt>
                <dd class="col-7"><strong>@Display.Window(order.PickupStartTime, order.PickupEndTime)</strong></dd>
                <dt class="col-5">Địa chỉ</dt>
                <dd class="col-7">@order.StoreAddress</dd>
                <dt class="col-5">Vé hết hạn</dt>
                <dd class="col-7">@Display.DateAndTime(ticket.ExpiresAt)</dd>
                <dt class="col-5">Món</dt>
                <dd class="col-7">@string.Join(", ", order.Items.Select(i => $"{i.OfferName} × {i.Quantity}"))</dd>
            </dl>
        </div>
    </div>

    <div class="d-flex gap-2 justify-content-center mt-3 d-print-none">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">In vé</button>
        <a class="btn btn-outline-success btn-sm" asp-action="Index">Đơn của tôi</a>
    </div>
</div>
