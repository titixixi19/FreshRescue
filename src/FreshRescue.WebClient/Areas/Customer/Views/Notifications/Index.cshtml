@model NotificationListViewModel
@{
    ViewData["Title"] = "Thông báo";
    string Icon(string type) => type switch
    {
        "NewSaleBatch" => "🆕",
        "PickupReminder" => "⏰",
        "OrderCancelledByStore" => "⚠️",
        _ => "🔔"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Thông báo</h1>
        <p class="text-muted mb-0">Đợt bán mới ở cửa hàng yêu thích, nhắc giờ nhận hàng, cửa hàng huỷ đơn.</p>
    </div>
    <div class="btn-group">
        <a class="btn btn-sm @(Model.UnreadOnly ? "btn-outline-success" : "btn-success")" asp-action="Index">Tất cả</a>
        <a class="btn btn-sm @(Model.UnreadOnly ? "btn-success" : "btn-outline-success")" asp-action="Index" asp-route-unreadOnly="true">Chưa đọc</a>
    </div>
</div>

@if (Model.Notifications.Items.Count == 0)
{
    <div class="fr-empty my-5">
        <div class="fr-empty-icon">🔔</div>
        <h2 class="h5">@(Model.UnreadOnly ? "Không có thông báo chưa đọc" : "Chưa có thông báo nào")</h2>
    </div>
}
else
{
    <div class="list-group mb-3">
        @foreach (var n in Model.Notifications.Items)
        {
            <div class="list-group-item d-flex gap-3 @(n.IsRead ? "" : "list-group-item-success")">
                <div class="fs-4">@Icon(n.Type)</div>
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between">
                        <strong>@n.Title</strong>
                        <span class="small text-muted">@Display.DateAndTime(n.CreatedAt)</span>
                    </div>
                    <div>@n.Body</div>
                    @if (n.Type == "NewSaleBatch" && n.RelatedEntityId is not null)
                    {
                        <a class="small" asp-controller="Storefront" asp-action="Index">Xem món đang bán</a>
                    }
                    else if (n.RelatedEntityId is { } orderId && n.Type != "NewSaleBatch")
                    {
                        <a class="small" asp-controller="Orders" asp-action="Details" asp-route-id="@orderId">Xem đơn</a>
                    }
                </div>
                @if (!n.IsRead)
                {
                    <form asp-action="MarkRead" method="post" class="align-self-center">
                        <input type="hidden" name="id" value="@n.Id" />
                        <input type="hidden" name="unreadOnly" value="@Model.UnreadOnly" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Đã đọc</button>
                    </form>
                }
            </div>
        }
    </div>
    <partial name="_Pager" model="@(new PagerModel(Model.Notifications.Page, Model.Notifications.TotalPages, page => Url.Action("Index", new { unreadOnly = Model.UnreadOnly ? "true" : null, page })!))" />
}
