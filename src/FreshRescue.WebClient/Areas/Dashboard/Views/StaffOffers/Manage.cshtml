@model FreshRescue.WebClient.Areas.Dashboard.Controllers.StaffOfferManageViewModel
@using FreshRescue.WebClient.Helpers
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Món trong đợt";
    var apiBaseUrl = (Configuration["Api:BaseUrl"] ?? string.Empty).Trim().TrimEnd('/');
}

<div class="dash-toolbar">
    <div>
        <h2>Món trong đợt — @Model.BatchName</h2>
        <p class="muted small">
            Trạng thái <span class="@Display.SaleBatchStatus(Model.BatchStatus).Css">@Display.SaleBatchStatus(Model.BatchStatus).Label</span>
            · SignalR: <span id="signalr-status-badge" class="badge badge-warn">Chưa kết nối</span>
        </p>
    </div>
    <div class="dash-actions">
        <a class="dash-btn-secondary"
           asp-area="Dashboard"
           asp-controller="SaleBatches"
           asp-action="Index">← Đợt bán</a>
    </div>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="dash-alert dash-alert-ok">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="dash-alert dash-alert-err">@err</div>
}

@if (Model.Offers is null || Model.Offers.Count == 0)
{
    <div class="dash-empty">
        <p>Không có offer trong đợt này.</p>
    </div>
}
else
{
    <div class="dash-table-wrap">
        <table class="dash-table"
               id="offers-manage-table"
               data-sale-batch-id="@Model.SaleBatchId"
               data-api-base="@apiBaseUrl">
            <thead>
                <tr>
                    <th>Tên</th>
                    <th>Giá</th>
                    <th>Tổng SL</th>
                    <th>Còn lại</th>
                    <th>Max/khách</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var o in Model.Offers)
            {
                <tr data-offer-id="@o.Id">
                    <td>@o.Name</td>
                    <td>@o.ActualPrice.ToString("N0")</td>
                    <td>@o.TotalQuantity</td>
                    <td><span class="remaining-qty-text">@o.RemainingQuantity</span></td>
                    <td>@o.MaxPerCustomer</td>
                    <td class="dash-actions">
                        <form asp-action="AdjustQuantity" method="post" class="inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="offerId" value="@o.Id" />
                            <input type="hidden" name="saleBatchId" value="@Model.SaleBatchId" />
                            <input type="number" name="totalQuantity" value="@o.TotalQuantity" min="1" class="dash-input dash-input-sm" style="width:5rem;" />
                            <button type="submit" class="link-ok">Cập nhật SL</button>
                        </form>
                        <form asp-action="Delete" method="post" class="inline-form"
                              onsubmit="return confirm('Xoá offer này khỏi đợt?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="offerId" value="@o.Id" />
                            <input type="hidden" name="saleBatchId" value="@Model.SaleBatchId" />
                            <button type="submit" class="link-danger">Xoá</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
    <script src="~/js/dashboard-signalr.js" asp-append-version="true"></script>
}
