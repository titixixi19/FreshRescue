@{
    ViewData["Title"] = "Import / Export Dữ liệu";
    var isBlocked = ViewData["IsBlocked"] as bool? ?? true;
    var blockReason = ViewData["BlockReason"] as string ?? "Đang chờ API hoàn thiện.";
}

<div class="dash-toolbar">
    <div>
        <h2>Import &amp; Export Dữ liệu</h2>
        <p class="muted small">Công cụ quản lý dữ liệu hàng loạt cho Brand Manager.</p>
    </div>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="dash-alert dash-alert-ok">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="dash-alert dash-alert-err">@err</div>
}

@if (isBlocked)
{
    <div class="dash-alert dash-alert-err" style="margin-bottom: 1.5rem;">
        <strong>Trạng thái: BLOCKED</strong> — @blockReason
    </div>
}

<div class="dash-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
    <!-- Box Export -->
    <div class="dash-card">
        <h3>Export dữ liệu (Excel)</h3>
        <p class="muted small" style="margin-bottom: 1rem;">Tải xuống danh sách đợt bán và thống kê ưu đãi dưới định dạng .xlsx.</p>
        <a asp-action="Export" class="dash-btn-secondary @(isBlocked ? "" : "")">Tải file Excel (Export)</a>
    </div>

    <!-- Box Import -->
    <div class="dash-card">
        <h3>Import dữ liệu (Excel)</h3>
        <p class="muted small" style="margin-bottom: 1rem;">Tải lên file mẫu để thêm danh sách ưu đãi hàng loạt.</p>
        <form asp-action="Import" method="post" enctype="multipart/form-data" class="dash-form">
            @Html.AntiForgeryToken()
            <div class="dash-field" style="margin-bottom: 1rem;">
                <input type="file" name="file" class="dash-input" accept=".xlsx, .xls" />
            </div>
            <button type="submit" class="dash-btn">Tải lên &amp; Xử lý (Import)</button>
        </form>
    </div>
</div>
