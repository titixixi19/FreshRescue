@model FreshRescue.WebClient.Areas.Dashboard.Models.StoreFormViewModel

@{
    ViewData["Title"] = "Tạo chi nhánh";
}

<div class="dash-toolbar">
    <div>
        <h2>Tạo chi nhánh</h2>
        <p class="muted small">Nhập thông tin chi nhánh mới của thương hiệu.</p>
    </div>
    <a class="dash-btn-secondary" asp-area="Dashboard" asp-controller="Stores" asp-action="Index">← Danh sách chi nhánh</a>
</div>

<form asp-area="Dashboard" asp-controller="Stores" asp-action="Create" method="post" class="dash-card dash-form">
    @Html.AntiForgeryToken()
    <partial name="_StoreFields" model="Model" />
    <div class="dash-form-actions">
        <button type="submit" class="dash-btn">Tạo chi nhánh</button>
        <a class="dash-btn-secondary" asp-area="Dashboard" asp-controller="Stores" asp-action="Index">Huỷ</a>
    </div>
</form>
