@model FreshRescue.WebClient.Areas.Dashboard.Models.StoreFormViewModel

@{
    ViewData["Title"] = "Cập nhật chi nhánh";
}

<div class="dash-toolbar">
    <div>
        <h2>Cập nhật chi nhánh</h2>
        <p class="muted small">Chỉnh sửa thông tin và trạng thái hoạt động của chi nhánh.</p>
    </div>
    <a class="dash-btn-secondary" asp-area="Dashboard" asp-controller="Stores" asp-action="Index">← Danh sách chi nhánh</a>
</div>

<form asp-area="Dashboard" asp-controller="Stores" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="dash-card dash-form">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <partial name="_StoreFields" model="Model" />
    <div class="dash-form-actions">
        <button type="submit" class="dash-btn">Lưu thay đổi</button>
        <a class="dash-btn-secondary" asp-area="Dashboard" asp-controller="Stores" asp-action="Index">Huỷ</a>
    </div>
</form>
