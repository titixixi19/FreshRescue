@model FreshRescue.WebClient.Areas.Dashboard.Models.StoreListViewModel

@{
    ViewData["Title"] = "Quản lý chi nhánh";
}

<div class="dash-toolbar">
    <div>
        <h2>Quản lý chi nhánh</h2>
        <p class="muted small">Chi nhánh là nơi khách đến nhận hàng — toạ độ dùng cho tìm "Cửa hàng gần tôi".</p>
    </div>
    <a class="dash-btn" asp-area="Dashboard" asp-controller="Stores" asp-action="Create">+ Tạo chi nhánh</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="dash-alert dash-alert-ok">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="dash-alert dash-alert-err">@error</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="dash-alert dash-alert-err">Không tải được danh sách chi nhánh: @Model.ErrorMessage</div>
}
else if (Model.Items.Count == 0)
{
    <div class="dash-empty">
        <h3>Chưa có chi nhánh nào</h3>
        <p class="muted">Tạo chi nhánh đầu tiên để nhân viên có thể mở đợt bán.</p>
    </div>
}
else
{
    <p class="muted small">Tổng cộng @Model.TotalCount chi nhánh.</p>
    <div class="dash-table-wrap">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Chi nhánh</th>
                    <th>Địa chỉ</th>
                    <th>Liên hệ</th>
                    <th>Giờ hoạt động</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var store in Model.Items)
                {
                    var area = string.Join(", ", new[] { store.Ward, store.District, store.City }.Where(x => !string.IsNullOrWhiteSpace(x)));
                    <tr>
                        <td><strong>@store.Name</strong></td>
                        <td>
                            @store.AddressLine
                            <div class="muted small">@area</div>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(store.Phone) ? "—" : store.Phone)</td>
                        <td class="muted small">
                            @if (!string.IsNullOrWhiteSpace(store.OpenTime) || !string.IsNullOrWhiteSpace(store.CloseTime))
                            {
                                @($"{store.OpenTime?[..Math.Min(5, store.OpenTime.Length)] ?? "—"} – {store.CloseTime?[..Math.Min(5, store.CloseTime.Length)] ?? "—"}")
                            }
                            else
                            {
                                <span>Chưa cập nhật</span>
                            }
                        </td>
                        <td>
                            @if (store.Status == "Active")
                            {
                                <span class="badge badge-ok">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge">Ngừng hoạt động</span>
                            }
                        </td>
                        <td class="dash-actions">
                            <a asp-area="Dashboard" asp-controller="Stores" asp-action="Edit" asp-route-id="@store.Id">Sửa</a>
                            <form asp-area="Dashboard" asp-controller="Stores" asp-action="Delete" asp-route-id="@store.Id"
                                  method="post" class="inline-form"
                                  onsubmit="return confirm('Xoá chi nhánh này? Lịch sử đơn của chi nhánh vẫn được giữ.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="link-danger">Xoá</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="dash-pager" aria-label="Phân trang">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <a class="@(p == Model.Page ? "active" : null)"
                   asp-area="Dashboard" asp-controller="Stores" asp-action="Index" asp-route-page="@p">@p</a>
            }
        </nav>
    }
}
