@model FreshRescue.WebClient.Areas.Dashboard.Models.StoreListViewModel

@{
    ViewData["Title"] = "Quản lý chi nhánh";
    var currentPage = Model.Page < 1 ? 1 : Model.Page;
    var totalPages = Model.TotalPages < 1 ? 1 : Model.TotalPages;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Quản lý chi nhánh</h1>
            <p class="text-muted mb-0">Xem và quản lý các chi nhánh của thương hiệu.</p>
        </div>
        <a asp-area="Dashboard"
           asp-controller="Stores"
           asp-action="Create"
           class="btn btn-primary">
            + Tạo chi nhánh
        </a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            Không thể tải danh sách chi nhánh: @Model.ErrorMessage
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Danh sách chi nhánh</strong>
            <span class="text-muted small">Tổng: @Model.TotalCount</span>
        </div>

        <div class="card-body p-0">
            @if (Model.Items.Count == 0)
            {
                <div class="text-center py-5">
                    <h2 class="h5">Chưa có dữ liệu chi nhánh</h2>
                    <p class="text-muted mb-0">
                        Nếu API chưa có dữ liệu hoặc chưa kết nối được, hãy kiểm tra thông báo lỗi phía trên.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Chi nhánh</th>
                                <th>Địa chỉ</th>
                                <th>Liên hệ</th>
                                <th>Giờ hoạt động</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var store in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@store.Name</div>
                                        <div class="text-muted small">
                                            ID: @store.Id
                                        </div>
                                    </td>
                                    <td>
                                        @store.AddressLine
                                        @if (!string.IsNullOrWhiteSpace(store.Ward))
                                        {
                                            <div class="text-muted small">Phường/Xã: @store.Ward</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(store.District))
                                        {
                                            <div class="text-muted small">Quận/Huyện: @store.District</div>
                                        }
                                        <div class="text-muted small">@store.City</div>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(store.Phone) ? "—" : store.Phone)</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(store.OpenTime) ||
                                             !string.IsNullOrWhiteSpace(store.CloseTime))
                                        {
                                            <span>@(store.OpenTime ?? "—") – @(store.CloseTime ?? "—")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa cập nhật</span>
                                        }
                                    </td>
                                    <td>
                                        @switch (store.Status)
                                        {
                                            case "Active":
                                                <span class="badge bg-success">Đang hoạt động</span>
                                                break;
                                            case "Inactive":
                                                <span class="badge bg-secondary">Ngừng hoạt động</span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-dark">@store.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a asp-area="Dashboard"
                                           asp-controller="Stores"
                                           asp-action="Edit"
                                           asp-route-id="@store.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Sửa
                                        </a>

                                        <form asp-area="Dashboard"
                                              asp-controller="Stores"
                                              asp-action="Delete"
                                              asp-route-id="@store.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc muốn xoá chi nhánh này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Xoá
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <span class="small text-muted">
                Trang @currentPage / @totalPages
            </span>
            <div class="btn-group">
                <a asp-area="Dashboard"
                   asp-controller="Stores"
                   asp-action="Index"
                   asp-route-page="@(currentPage - 1)"
                   class="btn btn-outline-secondary btn-sm @(currentPage <= 1 ? "disabled" : "")">
                    Trang trước
                </a>
                <a asp-area="Dashboard"
                   asp-controller="Stores"
                   asp-action="Index"
                   asp-route-page="@(currentPage + 1)"
                   class="btn btn-outline-secondary btn-sm @(currentPage >= totalPages ? "disabled" : "")">
                    Trang sau
                </a>
            </div>
        </div>
    </div>
</div>
