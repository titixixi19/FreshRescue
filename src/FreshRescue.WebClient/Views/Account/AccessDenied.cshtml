@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="fr-empty my-5">
    <div class="fr-empty-icon">🔒</div>
    <h1 class="h4">Bạn không có quyền vào trang này</h1>
    <p class="text-muted mb-4">
        Tài khoản <strong>@User.FindFirstValue(ClaimTypes.Email)</strong> không có vai trò phù hợp.
        Chức năng mua hàng chỉ dành cho tài khoản khách hàng.
    </p>
    <a class="btn btn-success" asp-area="Customer" asp-controller="Storefront" asp-action="Index">Về trang chủ</a>
</div>
