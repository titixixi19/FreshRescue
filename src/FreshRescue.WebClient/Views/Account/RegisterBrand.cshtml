@model FreshRescue.WebClient.Models.Account.RegisterBrandForm
@{
    ViewData["Title"] = "Đăng ký thương hiệu";
}

<div class="fr-auth-card card shadow-sm">
    <div class="card-body p-4">
        <h1 class="h4 mb-1">Đăng ký thương hiệu</h1>
        <p class="text-muted mb-4">Đưa đồ dư cuối ngày của chuỗi lên FreshRescue. Admin duyệt xong là mở bán được.</p>

        <form asp-action="RegisterBrand" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

            <h2 class="h6 text-muted">Thương hiệu</h2>
            <div class="mb-3">
                <label asp-for="BrandName" class="form-label">Tên thương hiệu</label>
                <input asp-for="BrandName" class="form-control" autofocus />
                <span asp-validation-for="BrandName" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="BrandDescription" class="form-label">Giới thiệu <span class="text-muted small">(không bắt buộc)</span></label>
                <textarea asp-for="BrandDescription" class="form-control" rows="2"></textarea>
                <span asp-validation-for="BrandDescription" class="text-danger small"></span>
            </div>

            <h2 class="h6 text-muted">Tài khoản quản lý</h2>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label">Họ và tên</label>
                <input asp-for="FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">Số điện thoại <span class="text-muted small">(không bắt buộc)</span></label>
                <input asp-for="PhoneNumber" class="form-control" type="tel" autocomplete="tel" />
            </div>
            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                    <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-success w-100">Gửi đăng ký</button>
        </form>

        <p class="text-center small mt-4 mb-0">
            Đã có tài khoản? <a asp-action="Login">Đăng nhập</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
