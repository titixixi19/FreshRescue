@model FreshRescue.WebClient.Models.Account.LoginForm
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Đăng nhập";
    var useMock = Configuration.GetValue<bool>(FreshRescue.WebClient.Extensions.WebClientServiceExtensions.UseMockApiKey);
}

<div class="fr-auth-card card shadow-sm">
    <div class="card-body p-4">
        <h1 class="h4 mb-1">Đăng nhập</h1>
        <p class="text-muted mb-4">Săn túi mù và món xả kho giá tốt quanh bạn.</p>

        <form asp-action="Login" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <div class="d-flex justify-content-between">
                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                    <a class="small" asp-action="ForgotPassword">Quên mật khẩu?</a>
                </div>
                <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-success w-100">Đăng nhập</button>
        </form>

        <p class="text-center small mt-4 mb-0">
            Chưa có tài khoản?
            <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng ký ngay</a>
        </p>
        <p class="text-center small mt-2 mb-0">
            Bạn là chủ cửa hàng?
            <a asp-action="RegisterBrand">Đăng ký thương hiệu</a>
        </p>
    </div>
</div>

@if (useMock)
{
    <div class="fr-auth-card alert alert-info small mt-3">
        <strong>Đang chạy MockApiClient.</strong> Tài khoản demo, mật khẩu <code>@FreshRescue.WebClient.Services.Mock.MockApiStore.DemoPassword</code>:
        <code>khach@demo.vn</code> (khách) · <code>nhanvien@demo.vn</code> · <code>thuonghieu@demo.vn</code> · <code>admin@demo.vn</code>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
