@model FreshRescue.WebClient.Models.Account.ForgotPasswordForm
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="fr-auth-card card shadow-sm">
    <div class="card-body p-4">
        <h1 class="h4 mb-1">Quên mật khẩu</h1>
        <p class="text-muted mb-4">Nhập email đã đăng ký, chúng tôi sẽ gửi link đặt lại mật khẩu.</p>

        <form asp-action="ForgotPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="mb-4">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-success w-100">Gửi link đặt lại</button>
        </form>

        <p class="text-center small mt-4 mb-0">
            <a asp-action="Login">← Quay lại đăng nhập</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
