@model ApiException
@{
    ViewData["Title"] = "Có lỗi xảy ra";
}

<div class="fr-empty my-5">
    <div class="fr-empty-icon">@(Model.Status == StatusCodes.Status404NotFound ? "🔍" : "⚠️")</div>
    <h1 class="h4">@(Model.Status == StatusCodes.Status404NotFound ? "Không tìm thấy" : "Không thực hiện được yêu cầu")</h1>
    <p class="text-muted mb-4">@Model.Message</p>
    <a class="btn btn-success" asp-area="Customer" asp-controller="Storefront" asp-action="Index">Về trang chủ</a>
    @if (Model.ErrorCode is not null)
    {
        <p class="small text-muted mt-3 mb-0">Mã lỗi: <code>@Model.ErrorCode</code></p>
    }
</div>
