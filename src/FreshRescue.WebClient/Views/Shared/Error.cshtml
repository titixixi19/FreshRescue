@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<div class="fr-empty my-5">
    <div class="fr-empty-icon">⚠️</div>
    <h1 class="h4">Đã có lỗi xảy ra</h1>
    <p class="text-muted mb-4">Hệ thống gặp sự cố khi xử lý yêu cầu của bạn. Vui lòng thử lại sau.</p>
    <a class="btn btn-success" asp-area="Customer" asp-controller="Storefront" asp-action="Index">Về trang chủ</a>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mt-3 mb-0">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }
</div>
