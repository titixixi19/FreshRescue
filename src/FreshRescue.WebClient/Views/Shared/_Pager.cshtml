@model PagerModel
@if (Model.TotalPages > 1)
{
    var first = Math.Max(1, Model.Page - 2);
    var last = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav aria-label="Phân trang" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" href="@Model.UrlForPage(Model.Page - 1)" aria-label="Trang trước">‹</a>
            </li>
            @for (var number = first; number <= last; number++)
            {
                <li class="page-item @(number == Model.Page ? "active" : "")" aria-current="@(number == Model.Page ? "page" : null)">
                    <a class="page-link" href="@Model.UrlForPage(number)">@number</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Model.UrlForPage(Model.Page + 1)" aria-label="Trang sau">›</a>
            </li>
        </ul>
    </nav>
}
