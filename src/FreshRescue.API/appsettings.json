{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7002",
      "http://localhost:5002"
    ]
  },
  "QrService": {
    "Address": "https://localhost:7003"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "FreshRescue.API",
    "Audience": "FreshRescue.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Ordering": {
    "LockingStrategy": "Pessimistic"
  },
  "PasswordReset": {
    "ResetUrl": "https://localhost:7002/Account/ResetPassword",
    "From": "no-reply@freshrescue.test",
    "SmtpHost": "",
    "PickupDirectory": "App_Data/emails"
  }
}
