<Project>

  <!--
    Quản lý phiên bản NuGet tập trung (Central Package Management).
    Trong .csproj chỉ ghi <PackageReference Include="..." /> — KHÔNG ghi Version.

    Vì sao: nếu mỗi người tự thêm package trong project của mình, chỉ vài ngày là
    solution có ba phiên bản EF Core khác nhau, và lỗi sẽ hiện ra lúc chạy chứ không
    phải lúc build. Đây là dạng không đồng nhất khó truy nhất.

    Cần thêm package mới? Thêm một dòng ở đây trước, rồi mới tham chiếu.
    Đổi phiên bản package đã có: hỏi Tùng.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="EF Core + SQL Server">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.31" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup Label="Identity + JWT">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.31" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.31" />
    <!-- Cho AppUser : IdentityUser<Guid> ở tầng Entities mà không kéo EF Core vào tầng đó. -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageVersion Include="Microsoft.AspNetCore.OData" Version="8.2.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Formatters.Xml" Version="2.2.0" />
    <PackageVersion Include="AutoMapper" Version="13.0.1" />
    <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.0" />
  </ItemGroup>

  <ItemGroup Label="Import/Export Excel (FR-B07, FR-B08, FR-A07)">
    <!-- Giấy phép MIT. Đã kiểm 29/09: chưa có lỗ hổng được công bố. -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup Label="gRPC">
    <PackageVersion Include="Grpc.AspNetCore" Version="2.66.0" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.66.0" />
    <!-- Sinh code client từ qr.proto ở API. Cùng phiên bản mà Grpc.AspNetCore 2.66.0 kéo về. -->
    <PackageVersion Include="Grpc.Tools" Version="2.66.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.27.0" />
  </ItemGroup>

  <ItemGroup Label="Kiểm thử">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FluentAssertions" Version="6.12.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.31" />
  </ItemGroup>

  <!--
    LƯU Ý: các số phiên bản trên là điểm khởi đầu. Lúc scaffold, Tùng chạy
    `dotnet restore` và chốt lại số thực tế khả dụng, rồi commit file này.
    Điều quan trọng không phải là con số nào, mà là CẢ NHÓM DÙNG CHUNG MỘT CON SỐ.
  -->

</Project>
